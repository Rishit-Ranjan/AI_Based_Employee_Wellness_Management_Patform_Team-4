# ============================================================================
# backend/.env.example
# Copy this file to backend/.env and fill in your own values.
#   Windows (PowerShell): Copy-Item backend\.env.example backend\.env
#   macOS/Linux:          cp backend/.env.example backend/.env
#
# ============================================================================

# --- Core ---
# Shared MongoDB connection string. Either a cloud Atlas URI (mongodb+srv://...)
# used by the whole team, or a local instance: mongodb://localhost:27017/...
MONGO_URI="your_mongodb_connection_string"
MONGO_DB_NAME="employee_wellness_analytics"

# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# IMPORTANT: the whole team must use the SAME value or auth cookies will be rejected.
JWT_SECRET_KEY="a-very-strong-and-secret-key-for-jwt"

# Frontend dev server URL (used for CORS and password-reset links).
FRONTEND_ORIGIN="http://localhost:5173"

# --- AI Services (Optional) ---
# AI Provider is fixed to Ollama for local development.
# AI_MODEL_NAME can be ANY model tag installed locally (run `ollama list` to see).
# The backend auto-detects installed models and falls back automatically, so any
# value here works — e.g. "gemma2:2b", "phi4-mini:latest", "qwen3.5:9b".
AI_LLM_PROVIDER=ollama
AI_MODEL_NAME="Your_model_name"
# Legacy alias, also honoured: OLLAMA_MODEL="gemma2:2b"

# Ollama Base URL
OLLAMA_BASE_URL="http://localhost:11434"

# --- SMS Notifications (Optional) ---
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="your_twilio_phone_number"
ADMIN_EMERGENCY_PHONE="phone_number_to_receive_sos_alerts"

# --- Email Notifications (Optional) ---
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME="your_email@example.com"
SMTP_PASSWORD="your_app_password"
EMAIL_FROM="your_email@example.com"